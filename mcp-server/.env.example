# ═══════════════════════════════════════════════════════════════════
# Image MCP Server — 环境变量配置
# ═══════════════════════════════════════════════════════════════════
#
# 1. 复制此文件为 .env:  cp .env.example .env   (或 copy .env.example .env)
# 2. 填入你的 API Key (见下方指引)
# 3. 可选: 修改模型名称或 Base URL
#
# ──── API Key 获取指引 ────
# SiliconFlow (识图): https://cloud.siliconflow.cn → API 密钥
# Agnes AI (生图):    https://apihub.agnes-ai.com  → API 密钥
# ═══════════════════════════════════════════════════════════════════

# ── 识图: SiliconFlow (OpenAI-compatible) ──
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_MODEL=nex-agi/Nex-N2-Pro

# 可选的其他 VISION_MODEL 值:
#   - Qwen/Qwen2.5-VL-72B-Instruct   (更强 OCR)
#   - deepseek-vl2                    (轻量)
#   - Pro/Qwen/Qwen2.5-VL-32B-Instruct (性价比)

# ── 生图: Agnes AI ──
AGNES_API_KEY=sk-your-agnes-api-key-here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
GENERATION_MODEL=agnes-image-2.1-flash

# 可选的其他 GENERATION_MODEL 值:
#   - flux-pro          (Flux 专业版)
#   - flux-dev          (Flux 开发版)
#   - agnes-image-2.1-flash (快速, 默认)

# ── 保存路径（可选）──
# 设置后, 生成的图片会自动下载到此目录
# 留空则只返回 URL
IMAGE_SAVE_DIR=
